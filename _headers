# Netlify: header keamanan & cache. File ini diabaikan oleh hosting lain.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(), geolocation=(), clipboard-write=(self), clipboard-read=(self)

/assets/img/*
  Cache-Control: public, max-age=604800

/sitemap.xml
  Content-Type: application/xml; charset=utf-8
